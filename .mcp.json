{
  "mcpServers": {
    "umbraco": {
      "command": "npx",
      "args": ["-y", "@umbraco-cms/mcp-dev@lts-17"],
      "env": {
        "NODE_TLS_REJECT_UNAUTHORIZED": "0",
        "UMBRACO_CLIENT_ID": "umbraco-back-office-mcp",
        "UMBRACO_CLIENT_SECRET": "1234567890",
        "UMBRACO_BASE_URL": "https://localhost:44372",
        "UMBRACO_INCLUDE_TOOL_COLLECTIONS": "document,media,document-type,data-type,template,language"
      }
    }
  }
}
