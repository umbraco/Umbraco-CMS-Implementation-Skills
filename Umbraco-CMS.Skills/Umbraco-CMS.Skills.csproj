<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Umbraco_CMS.Skills</RootNamespace>
    <CompressionEnabled>false</CompressionEnabled> <!-- Disable compression. E.g. for umbraco backoffice files. These files should be precompressed by node and not let dotnet handle it -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Clean" />
    <PackageReference Include="Umbraco.Cms" />
    <PackageReference Include="Umbraco.Cms.DevelopmentMode.Backoffice" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="config\lang\en-US.xml"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Skill example projects: compiled and loaded in-process so Umbraco-CMS.Skills.TestHost can
         assert their HTTP behaviour. Add one line per validated skill (mirrors the backoffice
         reference instance referencing its example extensions). -->
    <ProjectReference Include="../plugins/implementation/skills/umbraco-sitemap/examples/approach-a-cached-controller/Umbraco-Sitemap.Example.csproj" />
    <ProjectReference Include="../plugins/implementation/skills/umbraco-custom-error-pages/examples/approach-a-content-finder/Umbraco-CustomErrorPages.Example.csproj" />
    <ProjectReference Include="../plugins/implementation/skills/umbraco-configuration/examples/golden-configs/Umbraco-Configuration.Example.csproj" />
    <ProjectReference Include="../plugins/implementation/skills/umbraco-backoffice-localization/examples/approach-b-net-localization/Umbraco-BackofficeLocalization.NetLocalization.Example.csproj" />
    <ProjectReference Include="../plugins/implementation/skills/umbraco-services/examples/custom-service/Umbraco-Services.Example.csproj" />
    <ProjectReference Include="../plugins/implementation/skills/umbraco-composing/examples/approach-a-composer/Umbraco-Composing.Example.csproj" />
    <ProjectReference Include="../plugins/implementation/skills/umbraco-multilingual/examples/additional-cultures/Umbraco-Multilingual.AdditionalCultures.Example.csproj" />
    <ProjectReference Include="../plugins/implementation/skills/umbraco-health-check/examples/robots-txt/Umbraco-HealthCheck.Example.csproj" />
    <ProjectReference Include="../plugins/implementation/skills/umbraco-oembed-providers/examples/oembed-providers/Umbraco-OEmbedProviders.Example.csproj" />
    <ProjectReference Include="../plugins/implementation/skills/umbraco-nullable-reference-types/examples/approach-a-nullable-patterns/Umbraco-NullableReferenceTypes.Example.csproj" />
    <ProjectReference Include="../plugins/implementation/skills/umbraco-security-headers/examples/approach-a-middleware/Umbraco-SecurityHeaders.Example.csproj" />
    <ProjectReference Include="../plugins/implementation/skills/umbraco-notifications/examples/approach-a-handle-builtin/Umbraco-NotificationHandlers.Example.csproj" />
    <ProjectReference Include="../plugins/implementation/skills/umbraco-notifications/examples/approach-b-publish-custom/Umbraco-NotificationHandlers.ApproachB.Example.csproj" />
    <ProjectReference Include="../plugins/implementation/skills/umbraco-security-2fa/examples/users/Umbraco-Security2fa.Users.Example.csproj" />
    <ProjectReference Include="../plugins/implementation/skills/umbraco-debugging/examples/approach-a-sourcelink-probe/Umbraco-Debugging.SourceLinkProbe.Example.csproj" />
    <ProjectReference Include="../plugins/implementation/skills/umbraco-debugging/examples/approach-b-profiler/Umbraco-Debugging.Profiler.Example.csproj" />
    <ProjectReference Include="../plugins/implementation/skills/umbraco-security-external-logins/examples/users-backoffice/Umbraco-ExternalLogins.Users.Example.csproj" />
    <ProjectReference Include="../plugins/implementation/skills/umbraco-security-external-logins/examples/members-website/Umbraco-ExternalLogins.Members.Example.csproj" />
    <!-- Compile-only examples are NOT referenced here — they would collide with the above (e.g.
         two controllers on GET /sitemap.xml). They're in the solution instead, so the build still
         compiles them. See each project's header. -->
  </ItemGroup>

  <ItemGroup>
    <!-- Opt-in to app-local ICU to ensure consistent globalization APIs across different platforms -->
    <PackageReference Include="Microsoft.ICU.ICU4C.Runtime" />
    <RuntimeHostConfigurationOption Include="System.Globalization.AppLocalIcu" Value="72.1.0.3" Condition="$(RuntimeIdentifier.StartsWith('linux')) or $(RuntimeIdentifier.StartsWith('win')) or ('$(RuntimeIdentifier)' == '' and !$([MSBuild]::IsOSPlatform('osx')))" />
  </ItemGroup>


  <PropertyGroup>
    <!-- Razor files are needed for the backoffice to work correctly -->
    <CopyRazorGenerateFilesToPublishDirectory>true</CopyRazorGenerateFilesToPublishDirectory>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Remove RazorCompileOnBuild and RazorCompileOnPublish when not using ModelsMode InMemoryAuto -->
    <RazorCompileOnBuild>false</RazorCompileOnBuild>
    <RazorCompileOnPublish>false</RazorCompileOnPublish>
  </PropertyGroup>

</Project>
