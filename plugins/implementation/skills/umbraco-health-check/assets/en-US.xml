<!-- Install at ~/config/lang/en-US.xml in the site, or App_Plugins/{YourPackage}/lang/en-US.xml in a package. Add one file per backoffice culture (da-DK.xml, ...). -->
<language alias="en-US" intName="English (United States)" localName="English (United States)" culture="en-US">
  <area alias="healthcheck">
    <key alias="seoRobotsCheckSuccess">The robots.txt file exists.</key>
    <key alias="seoRobotsCheckFailed">The robots.txt file does not exist.</key>
    <key alias="seoRobotsRectifyButtonName">Create robots.txt</key>
    <key alias="seoRobotsRectifyDescription">Create a default robots.txt file in the root of the site to provide crawler guidance.</key>
    <key alias="seoRobotsRectifyFailed">The robots.txt file could not be created.</key>
  </area>
</language>
