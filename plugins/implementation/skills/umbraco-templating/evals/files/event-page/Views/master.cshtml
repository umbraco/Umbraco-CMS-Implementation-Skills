@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    Layout = null;
    var siteName = Model.Value<string>("siteName", fallback: Fallback.ToAncestors);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@Model.Name | @siteName</title>
</head>
<body>
    <header><a href="/">@siteName</a></header>
    <main>
        @RenderBody()
    </main>
    @Html.Partial("footer")
</body>
</html>
