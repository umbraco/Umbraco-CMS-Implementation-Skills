// Copy to .vscode/launch.json in the web project's folder (VS Code reads it as JSON with comments).
{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Umbraco: launch with Umbraco source",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/bin/Debug/net10.0/<ProjectName>.dll",
      "args": [],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "justMyCode": false,
      "suppressJITOptimizations": true,
      "symbolOptions": {
        "searchMicrosoftSymbolServer": true,
        "searchNuGetOrgSymbolServer": true
      },
      "sourceLinkOptions": {
        "*": { "enabled": true }
      }
    }
  ]
}
