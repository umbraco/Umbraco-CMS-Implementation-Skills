<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    VALIDATION-ONLY example project for umbraco-debugging — Approach B's IProfiler controller.

    Loaded by SITE 1 (Umbraco-CMS.Skills, Clean). The skill's ProfiledController.cs is generated into
    obj/ at build time by plugins/Directory.Build.props, with <Namespace> substituted.
    ProfilerTests.cs sits beside it but is compiled by Umbraco-CMS.Skills.TestHost.

    Razor SDK so the controller registers as an application part.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Umbraco.Skills.Examples.Debugging.Profiler</RootNamespace>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Umbraco.Cms.Web.Website" />
  </ItemGroup>

</Project>
