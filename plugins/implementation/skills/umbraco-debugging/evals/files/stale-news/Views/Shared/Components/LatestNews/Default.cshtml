@model List<Acme.Web.Components.LatestNewsItem>
@if (Model.Count > 0)
{
    <aside class="latest-news">
        <h2>Latest news</h2>
        <ul>
            @foreach (var item in Model)
            {
                <li><a href="@item.Url">@item.Headline</a></li>
            }
        </ul>
    </aside>
}
