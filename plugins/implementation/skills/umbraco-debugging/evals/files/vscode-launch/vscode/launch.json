{
  // Copied from our old Umbraco 13 site and tweaked. F5 starts the site and our own breakpoints hit,
  // but F11 on any Umbraco call just steps over it.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Acme.Web",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/bin/Debug/net8.0/Acme.Web.dll",
      "args": [],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "searchMicrosoftSymbolServer": true,
      "sourceLinkOptions": {
        "*": { "enabled": false }
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    }
  ]
}
