@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@Model.Name | Contoso</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700&display=swap" rel="stylesheet" />
    <link href="/css/site.css" rel="stylesheet" asp-append-version="true" />
    <script asp-csp-nonce>
        window.cookieBannerConfig = { domain: "contoso.com", categories: ["necessary", "analytics"] };
    </script>
    <script src="/js/cookie-banner.js" asp-append-version="true"></script>
</head>
<body>
    @RenderBody()
</body>
</html>
