<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    VALIDATION-ONLY example project for the umbraco-oembed-providers skill.

    It is a compilable projection of the skill's assets
    (three embed providers + composer) with the
    <Namespace> placeholder substituted for a fixed namespace. The reference
    instance (Umbraco-CMS.Skills) references this project so the code is compiled
    and loaded in-process, and Umbraco-CMS.Skills.TestHost asserts IOEmbedService results
    in-process (offline). The .cs files are projected from assets/ into obj/ at
    build time (plugins/Directory.Build.props). Not shipped; not part of any plugin.

    Razor SDK to match the other examples.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Umbraco.Skills.Examples.OEmbedProviders</RootNamespace>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>

  <ItemGroup>
    <!-- Web.Website pulls in Web.Common + Core + Infrastructure transitively, covering the
         Umbraco.Cms.* namespaces the assets use. Version comes from the repo-root
         Directory.Packages.props, so it stays in lockstep with the Umbraco the host loads. -->
    <PackageReference Include="Umbraco.Cms.Web.Website" />
  </ItemGroup>

</Project>
