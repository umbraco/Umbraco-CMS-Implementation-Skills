<Project Sdk="Microsoft.NET.Sdk">

  <!--
    VALIDATION-ONLY example project for umbraco-multilingual — the additional-cultures composer.

    Loaded by SITE 1 (Umbraco-CMS.Skills, Clean): the composer is C# that registers into DI
    (AddUnique<IIsoCodeValidator>, AddUnique<ICultureService>), and nothing else on that host
    replaces either service. The skill's AllowAdditionalCulturesComposer.cs is generated into obj/ at
    build time by plugins/Directory.Build.props, with <Namespace> and <AdditionalIsoCode> substituted,
    and picked up by the host's AddComposers() scan. AdditionalCulturesTests.cs sits beside it but is
    compiled by Umbraco-CMS.Skills.TestHost.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Umbraco.Skills.Examples.Multilingual.AdditionalCultures</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Umbraco.Cms.Web.Website" />
  </ItemGroup>

</Project>
