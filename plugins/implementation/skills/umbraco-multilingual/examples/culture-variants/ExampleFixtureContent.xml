  <Templates>
    <Template>
      <Name>Multilingual Page</Name>
      <Alias>multilingualPage</Alias>
      <Key>b8e3f1a4-5c27-4d90-8f6b-2a1d7e4c9053</Key>
      <Design><![CDATA[@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@using Umbraco.Cms.Core.Models.PublishedContent
@using Umbraco.Cms.Core.Models.Blocks
@{ Layout = null; }<!DOCTYPE html>
<html>
<head>
<title>@Model.Name</title>
@await Html.PartialAsync("hreflangLinks")
</head>
<body>
@await Html.PartialAsync("languageSwitcher")
<h1 id="title">@Model.Value("title", fallback: Fallback.ToLanguage)</h1>
<p id="code">@Model.Value("code")</p>
<p id="read-more">@Umbraco.GetDictionaryValueOrDefault("ReadMore", "DICTIONARY-MISSING")</p>
<ul id="blocks">@foreach (var b in (IEnumerable<BlockListItem>?)Model.Value<BlockListModel>("blocks") ?? Enumerable.Empty<BlockListItem>()) {<li class="block">@b.Content.Value("blockTitle")|@b.Content.Value("blockCode")</li>}</ul>
<ul id="blocks-fallback">@foreach (var b in (IEnumerable<BlockListItem>?)Model.Value<BlockListModel>("blocks", fallback: Fallback.ToLanguage) ?? Enumerable.Empty<BlockListItem>()) {<li class="block">@b.Content.Value("blockTitle")|@b.Content.Value("blockCode")</li>}</ul>
</body>
</html>]]></Design>
    </Template>
