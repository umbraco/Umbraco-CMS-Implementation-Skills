<Project Sdk="Microsoft.NET.Sdk">

  <!--
    VALIDATION-ONLY example project for umbraco-backoffice-localization, approach A (UI localization).

    Loaded by SITE 2 (Umbraco-CMS.Skills.Blank). The skill's assets (umbraco-package.json, en.js, da.js,
    core-overrides-package.json) are generated into obj/ at build time by plugins/Directory.Build.props
    and embedded from there. ExampleHostWiring.cs writes them under the host's App_Plugins at start-up,
    exactly where a user would put them, and BackofficeLocalizationBlankTests.cs asserts that Umbraco
    registers them and serves the JS.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Umbraco.Skills.Examples.BackofficeLocalization.UiLocalization</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Umbraco.Cms.Web.Website" />
  </ItemGroup>

</Project>
