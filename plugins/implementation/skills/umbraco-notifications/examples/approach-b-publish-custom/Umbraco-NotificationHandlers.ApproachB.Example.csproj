<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    VALIDATION-ONLY example project for the umbraco-notifications skill's
    Approach B (publish your own notification).

    It is a compilable projection of the skill's ContentImportCompleted* assets
    with the <Namespace> placeholder substituted for a fixed namespace, plus
    ExampleHostWiring.cs (composer: registers the shipped handler, a singleton
    ImportNotificationRecorder and a test-only RecordingImportHandler). The
    reference instance (Umbraco-CMS.Skills) references this project so the code
    is compiled and loaded in-process, and Umbraco-CMS.Skills.TestHost asserts
    delivery via IEventAggregator and via scope.Notifications.
    Not shipped to users; not part of any plugin.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Umbraco.Skills.Examples.NotificationHandlersApproachB</RootNamespace>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Umbraco.Cms.Web.Website" />
  </ItemGroup>

</Project>
