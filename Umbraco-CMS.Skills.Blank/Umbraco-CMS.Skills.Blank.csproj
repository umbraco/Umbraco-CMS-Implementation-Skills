<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    SITE 2 of two reference hosts. Deliberately has NO starter kit.

    Site 1 (Umbraco-CMS.Skills, with Clean) validates approaches whose implementation lives in C#
    that registers into DI — controllers, IContentFinders, composers. There, Clean is harmless
    ambient content to traverse and render.

    This host validates approaches whose implementation IS Document Types + templates + config.
    Clean must be absent for those, because Clean is itself a competing implementation of the very
    features under test: it ships an xMLSitemap Document Type with its own Views/xMLSitemap.cshtml,
    and an `error` type with its own Views/error.cshtml. Asserting against those would prove Clean
    works, not that the skill's guidance works.

    Content therefore comes from each referenced example's own package migration, built to the
    skill's spec. See .claude/skills/umbraco-skill-author/references/runtime-validation.md.

    There is also a hard reason the two can't be one host: umbraco-custom-error-pages Approach A
    calls SetContentLastChanceFinder, which is AddUnique<IContentLastChanceFinder, T>() and so
    REPLACES Umbraco's own ContentFinderByConfigured404 — and that class is Approach B's entire
    implementation. A and B can never both be live in one process.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Umbraco_CMS.Skills.Blank</RootNamespace>
    <CompressionEnabled>false</CompressionEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- No Clean — that's the whole point of this host.

         Razor RUNTIME compilation, on the other hand, is required: templates here are written to
         Views/ at runtime by a package migration, so without it the view is never compiled, Umbraco
         decides the content has no usable template, and every front-end URL answers 404.

         It's referenced DIRECTLY rather than picked up as a side effect of
         Umbraco.Cms.DevelopmentMode.Backoffice (whose InMemoryAuto ModelsBuilder mode also enables
         it). That package cannot be used here: under WebApplicationFactory its InMemoryModelFactory
         gets disposed while the host is still live, and then ANY content operation that touches URL
         generation dies on "Cannot access a disposed object: ReaderWriterLockSlim" — which surfaces as
         fixture content silently never being created. -->
    <PackageReference Include="Umbraco.Cms" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Razor.RuntimeCompilation" />
  </ItemGroup>

  <ItemGroup>
    <!-- Site 2's baseline content shape: one root node that every example hangs its subtree from. -->
    <EmbeddedResource Include="FixtureSite/fixture-site-package.xml" LogicalName="fixture-site-package.xml" />
    <!-- Static seeding helpers. Referenced as a PROJECT, not linked as source: linking compiled
         the same types into every consumer, and because the host references the examples the
         compiler saw duplicates and warned (CS0436). -->
    <ProjectReference Include="../ExampleFixtures.Shared/ExampleFixtures.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Content-shaped example projects (Approach B). Each carries its own package migration that
         seeds the Document Types, templates and content it needs at boot. -->
    <ProjectReference Include="../plugins/implementation/skills/umbraco-sitemap/examples/approach-b-razor-template/Umbraco-Sitemap.ApproachB.Example.csproj" />
    <ProjectReference Include="../plugins/implementation/skills/umbraco-custom-error-pages/examples/approach-b-config-based/Umbraco-CustomErrorPages.ApproachB.Example.csproj" />
    <ProjectReference Include="../plugins/implementation/skills/umbraco-custom-maintenance-page/examples/approach-a-upgrading-viewpath/Umbraco-CustomMaintenancePage.Example.csproj" />
    <ProjectReference Include="../plugins/implementation/skills/umbraco-templating/examples/render-pipeline/Umbraco-Templating.Example.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Templates created by a package migration are written to disk as .cshtml and compiled at
         runtime, so Razor files must survive and must not be precompiled away. -->
    <CopyRazorGenerateFilesToPublishDirectory>true</CopyRazorGenerateFilesToPublishDirectory>
    <RazorCompileOnBuild>false</RazorCompileOnBuild>
    <RazorCompileOnPublish>false</RazorCompileOnPublish>
  </PropertyGroup>

</Project>
