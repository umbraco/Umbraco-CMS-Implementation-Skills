<Project>
  <!--
    ONE pin surface for the whole repo — both reference hosts, every skill example project, and the
    test hosts. It lives at the root rather than inside a host project on purpose: the examples must
    compile against exactly the Umbraco the host loads at runtime. While they carried their own
    floating `Version="17.*"`, a 17.6 release would have silently built the examples against a
    different Umbraco than the host — non-reproducible builds, and possible assembly-version skew at
    runtime. (It had not bitten yet: 17.* still resolved to 17.5.3.)

    Floating versions are deliberately NOT enabled here, so that failure mode cannot come back.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- Umbraco. Keep Web.Website and Api.Management in lockstep with Umbraco.Cms: the examples reference them
       directly, the hosts pull them in transitively via the latter. -->
  <ItemGroup>
    <PackageVersion Include="Clean" Version="7.0.8" />
    <PackageVersion Include="Umbraco.Cms" Version="17.5.3" />
    <PackageVersion Include="Umbraco.Cms.Web.Website" Version="17.5.3" />
    <PackageVersion Include="Umbraco.Cms.Api.Management" Version="17.5.3" />
    <PackageVersion Include="Umbraco.Cms.DevelopmentMode.Backoffice" Version="17.5.3" />
    <PackageVersion Include="Microsoft.ICU.ICU4C.Runtime" Version="72.1.0.3" />
    <!-- Razor runtime compilation for the starter-kit-free host, whose templates are written
         to disk at runtime by a package migration. -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Razor.RuntimeCompilation" Version="10.0.10" />
    <!-- The external-logins skill's examples sign in through OpenID Connect. -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.10" />
  </ItemGroup>

  <!-- Third-party packages a skill tells users to install, so its example compiles against them. -->
  <ItemGroup>
    <!-- umbraco-security-2fa: TOTP codes and QR generation. -->
    <PackageVersion Include="GoogleAuthenticator" Version="3.2.0" />
  </ItemGroup>

  <!-- Test hosts. -->
  <ItemGroup>
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.10" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.0" />
    <PackageVersion Include="NUnit" Version="4.3.2" />
    <PackageVersion Include="NUnit.Analyzers" Version="4.7.0" />
    <PackageVersion Include="NUnit3TestAdapter" Version="5.0.0" />
  </ItemGroup>
</Project>
